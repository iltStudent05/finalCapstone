# API Environment Variables
PORT=4000
NODE_ENV=development
# Local (no auth) Mongo; in Docker Compose this is overridden with credentials
MONGODB_URI=mongodb://localhost:27017/task-tracker
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d
# Vite dev server origin; Docker Compose overrides this with the Nginx origin
CLIENT_URL=http://localhost:5173
